#!/bin/bash
export MSYS_NO_PATHCONV=1
set -e

S2I_EXE=s2i
if [ -z "$(type -P "$S2I_EXE")" ]; then
  echo -e "The ${S2I_EXE} executable is needed and not on your path."
  echo -e "It can be downloaded from here: https://github.com/openshift/source-to-image"
  echo -e "Make sure you place it in a directory on your path."
  exit 1
fi

SCRIPT_HOME="$(cd "$(dirname "$0")" && pwd)"
export COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME-unified-scheduling}"

# =================================================================================================================
# Usage:
# -----------------------------------------------------------------------------------------------------------------
usage() {
  cat <<-EOF

  Usage: $0 {start|start-proxy|debug|debug-proxy|stop|build|proxy|upgrade-db-16-18|rm|down}

  Options:

  build - Build the docker images for the project.
          You need to do this first, since the builds require some s2i builds.
          You can build individual components as shown below, components that have dependencies
          will have these dependencies built too.  By default all components are built.

          Examples:
          - Build everything:
            $0 build
          - Build the api only:
            $0 build api
          - Build the web only:
            $0 build web-dev

          Containers:
            - api
            - web-dev

  start - Creates the application containers from the built images
          and starts the services based on the docker-compose.yaml file.
          Example:
            $0 start

  debug - Used for local development that enables hot reloading for BE.
          Creates the application containers from the built images
          and starts the services based on the docker-compose.yaml file.
          Example:
            $0 debug

  start-proxy | debug-proxy - Use the same startup paths with Nginx in front of Vite.
          Application: http://localhost:8080/sheriff-scheduling/
          Direct start/debug application: http://localhost:8080/
          Proxy mode requires Docker Compose 2.24.4 or newer.

  stop - Stops the services.  This is a non-destructive process.  The containers
         are not deleted so they will be reused the next time you run start.

  proxy - Runs a Docker Compose maintenance command with the frontend proxy
          override and profile. Use start-proxy/debug-proxy to start or switch modes.
          Examples:
            $0 proxy logs -f proxy web api
            $0 proxy ps
          Application: http://localhost:8080/sheriff-scheduling/

  upgrade-db-16-18 - Backs up the running PostgreSQL 16 database, replaces its
                     container with PostgreSQL 18, and restores the backup.
                     Example:
                       $0 upgrade-db-16-18

  down | rm - Brings down the services and removes the volumes (storage) and containers. Destructive.
EOF
exit 1
}
# -----------------------------------------------------------------------------------------------------------------
# Default Settings:
# -----------------------------------------------------------------------------------------------------------------
RUNTIME_CONTAINERS="db api web"
DEBUG_CONTAINERS="db api web"
# -----------------------------------------------------------------------------------------------------------------
# Functions:
# -----------------------------------------------------------------------------------------------------------------
build-all() {
  build-web
  build-api
}

build-api() {
  #
  # api
  #
  echo -e "\n\n===================================================================================================="
  echo -e "Building api image using docker ..."
  echo -e "----------------------------------------------------------------------------------------------------"
  docker build \
    -t "${COMPOSE_PROJECT_NAME}-api" \
    -f './api/Dockerfile.dev' '..'

  echo -e "===================================================================================================="
}

build-web() {
  #
  # web-dev
  #
  echo -e "\n\n===================================================================================================="
  echo -e "Building the ${COMPOSE_PROJECT_NAME}-web (dev) image using Docker ..."
  echo -e "----------------------------------------------------------------------------------------------------"
  docker build \
    -t "${COMPOSE_PROJECT_NAME}-web" \
    --build-arg NODE_VERSION=22 \
    --build-arg VITE_PORT=8080 \
    --build-arg WEB_SRC='./web' \
    -f './web/Dockerfile.dev' '..'
  echo -e "===================================================================================================="
}

build-web-prod() {
  #
  # web-prod (production image with S2I for testing)
  #
  echo -e "\n\n===================================================================================================="
  echo -e "Building the ${COMPOSE_PROJECT_NAME}-web-prod (production) image using Docker ..."
  echo -e "----------------------------------------------------------------------------------------------------"
  docker build \
    -t "${COMPOSE_PROJECT_NAME}-web-prod" \
    --build-arg NODE_VERSION=22 \
    --build-arg WEB_SRC='../web' \
    --build-arg NGINX_RUNTIME_SRC='./nginx-runtime' \
    --build-arg VUE_ON_NGINX_SRC='./vue-on-nginx' \
    -f './web/Dockerfile' '.'
  echo -e "===================================================================================================="
}

configureEnvironment () {

  if [ -f .env ]; then
    echo -e "\nLoading environment variables from .env ...\n"
    source .env
  fi

  for arg in "$@"; do
    case "$arg" in
      *=*)
        export "${arg}"
        ;;
    esac
  done

  # Default database startup parameters
  export POSTGRESQL_DATABASE=${POSTGRESQL_DATABASE:-unifieddb}
  export POSTGRESQL_USER=${POSTGRESQL_USER:-uniuser}
  export POSTGRESQL_PASSWORD=${POSTGRESQL_PASSWORD:-unipassword}
  export POSTGRESQL_ADMIN_PASSWORD=${POSTGRESQL_ADMIN_PASSWORD:-admin123}

  export KeycloakAuthority=${KeycloakAuthority}
  export KeycloakClient=${KeycloakClient}
  export KeycloakSecret=${KeycloakSecret}
  export KeycloakAudience=${KeycloakAudience}
  export SiteMinderLogoutUrl="${SiteMinderLogoutUrl}"
  

  # Default API startup parameters
  export API_URL=${API_URL-http://api:5000/api/}
  
  # Default web startup parameters
  export WEB_BASE_HREF=${WEB_BASE_HREF}
}

getStartupParams() {
  CONTAINERS=()
  ARGS=()

  for arg in "$@"; do
    case "$arg" in
      *=*)
        # Skip it
        ;;
     -*)
        ARGS+=("$arg");;
      *)
        CONTAINERS+=("$arg");;
    esac
  done

  if [ "${#CONTAINERS[@]}" -eq 0 ]; then
      if [ -z "$DEBUG_MODE" ]; then
        read -r -a CONTAINERS <<< "$RUNTIME_CONTAINERS"
      else
        read -r -a CONTAINERS <<< "$DEBUG_CONTAINERS"
      fi
  fi
}

configureCompose() {
  if docker compose version >/dev/null 2>&1; then
    COMPOSE=(docker compose)
  else
    COMPOSE=(docker-compose)
  fi
}

requireProxyCompose() {
  local version major minor patch
  version=$("${COMPOSE[@]}" version --short)
  version=${version#v}
  IFS=. read -r major minor patch <<< "${version%%[-+]*}"
  if [[ ! "$major" =~ ^[0-9]+$ || ! "$minor" =~ ^[0-9]+$ || ! "$patch" =~ ^[0-9]+$ ]] ||
     (( major < 2 || (major == 2 && (minor < 24 || (minor == 24 && patch < 4))) )); then
    echo "Proxy mode requires Docker Compose 2.24.4+ for !override; found $version." >&2
    exit 1
  fi
}

proxyCompose() {
  "${COMPOSE[@]}" -f docker-compose.yaml -f docker-compose.proxy.yaml --profile proxy-repro "$@"
}

configureFrontend() {
  export WEB_BASE_HREF=/
  if [ -n "$FRONTEND_PROXY_MODE" ]; then
    export WEB_BASE_HREF=/sheriff-scheduling/
  fi
}

optionalFrontends() {
  local action="$1" service ids
  # Labels also find a proxy from a previous mode and the retired release frontend.
  for service in proxy web-release; do
    ids=$(docker ps --all --quiet \
      --filter "label=com.docker.compose.project=$COMPOSE_PROJECT_NAME" \
      --filter "label=com.docker.compose.service=$service")
    if [ -n "$ids" ]; then
      if [ "$action" = remove ]; then
        docker rm --force $ids
      else
        docker stop $ids
      fi
    fi
  done
}

prepareWebContainer() {
  local ids id details name mode desiredMode=direct
  if [ -n "$FRONTEND_PROXY_MODE" ]; then
    desiredMode=proxy
  fi

  ids=$(docker ps --all --quiet \
    --filter "label=com.docker.compose.project=$COMPOSE_PROJECT_NAME" \
    --filter "label=com.docker.compose.service=web" \
    --filter "label=com.docker.compose.oneoff=False")
  for id in $ids; do
    details=$(docker inspect --format '{{.Name}} {{if index .HostConfig.PortBindings "8080/tcp"}}direct{{else}}proxy{{end}}' "$id")
    read -r name mode <<< "$details"
    # Create fresh on mode changes instead of carrying a Compose replacement name.
    # Also repair a temporary name retained by an earlier recreation.
    if [ "$mode" != "$desiredMode" ] ||
       [[ "$name" =~ ^/[[:xdigit:]]{12}_"$COMPOSE_PROJECT_NAME"[-_]web[-_][0-9]+$ ]]; then
      docker rm --force "$id"
    fi
  done
}

startServices() {
  local service startFrontend=
  getStartupParams "$@"
  configureEnvironment "$@"
  configureFrontend
  configureCompose

  if [ -n "$FRONTEND_PROXY_MODE" ]; then
    requireProxyCompose
  fi

  for service in "${CONTAINERS[@]}"; do
    if [ "$service" = web ]; then
      startFrontend=1
    fi
  done
  if [ -n "$startFrontend" ]; then
    # Release 8080 before direct startup; restart Nginx after Vite gets a new IP.
    # Removing these optional containers never removes their volumes or the API/db.
    optionalFrontends remove
    prepareWebContainer
    if [ -n "$FRONTEND_PROXY_MODE" ]; then
      CONTAINERS+=(proxy)
    fi
  fi

  if [ -n "$FRONTEND_PROXY_MODE" ]; then
    proxyCompose up "${ARGS[@]}" "${CONTAINERS[@]}"
  else
    "${COMPOSE[@]}" up "${ARGS[@]}" "${CONTAINERS[@]}"
  fi
}

toLower() {
  echo $(echo ${@} | tr '[:upper:]' '[:lower:]')
}

functionExists() {
  (
    if [ ! -z ${1} ] && type ${1} &>/dev/null; then
      return 0
    else
      return 1
    fi
  )
}

deleteVolumes() {
  _projectName=${COMPOSE_PROJECT_NAME:-docker}

  echo "Stopping and removing any running containers ..."
  configureCompose
  optionalFrontends remove
  "${COMPOSE[@]}" down -v

  _pattern="^${_projectName}_\|^docker_"
  _volumes=$(docker volume ls -q | grep ${_pattern} | cat)

  if [ ! -z "${_volumes}" ]; then
    echo "Removing project volumes ..."
    echo ${_volumes} | xargs docker volume rm
  else
    echo "No project volumes exist."
  fi

  echo "Removing build cache ..."
  rm -Rf ../api/bin
  rm -Rf ../api/obj
  rm -Rf ../db/bin
  rm -Rf ../db/obj
}
# =================================================================================================================

pushd ${SCRIPT_HOME} >/dev/null
COMMAND=$(toLower ${1})
shift

case "$COMMAND" in
  start|start-proxy|debug|debug-proxy)
    FRONTEND_PROXY_MODE=
    case "$COMMAND" in
      *-proxy) FRONTEND_PROXY_MODE=1 ;;
    esac
    case "$COMMAND" in
      debug*) export DEBUG_MODE=1 ;;
    esac
    startServices "$@"
    ;;
  stop)
    configureEnvironment
    configureCompose
    optionalFrontends stop
    "${COMPOSE[@]}" stop
    ;;
  proxy)
    if [ "$#" -eq 0 ]; then
      usage
    fi
    configureEnvironment
    FRONTEND_PROXY_MODE=1
    configureFrontend
    configureCompose
    requireProxyCompose
    proxyCompose "$@"
    ;;
  upgrade-db-16-18)
    configureEnvironment
    FRONTEND_PROXY_MODE=
    configureFrontend
    optionalFrontends stop
    bash ./upgrade-postgres-16-to-18.sh
    ;;
  rm|down)
    configureEnvironment
    deleteVolumes
    ;;
  build)
    buildImage=$(toLower ${1})
    shift || buildImage=all
    buildImage=$(echo ${buildImage} | sed s~^vcr-~~)
    case "$buildImage" in
      *=*)
        buildImage=all
        ;;
    esac

    if functionExists "build-${buildImage}"; then
      eval "build-${buildImage}"
    else
      echo -e "Error:\nThe build function, build-${buildImage}, does not exist.  Please check your build parameters and try again.\nUse '-h' to get full help details."
      exit 1
    fi
    ;;
  *)
    usage
esac

popd >/dev/null
