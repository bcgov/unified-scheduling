# Keep this image version aligned with the Microsoft.Playwright package. It includes
# Chromium and its Linux dependencies; the SDK install below retains dotnet watch support.
FROM mcr.microsoft.com/playwright/dotnet:v1.62.0-noble

RUN curl -sSL https://dot.net/v1/dotnet-install.sh | bash /dev/stdin \
    --version 10.0.301 \
    --install-dir /usr/share/dotnet

ENV ASPNETCORE_ENVIRONMENT='Production'
ENV ASPNETCORE_URLS='http://+:5000'
ENV CORS_DOMAIN='http://localhost:8080'
ENV DOTNET_STARTUP_PROJECT='./api/Unified.Api/Unified.Api.csproj'
ENV DOTNET_USE_POLLING_FILE_WATCHER=1
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

RUN curl -sSL https://aka.ms/getvsdbgsh | /bin/sh /dev/stdin -v latest -l /vsdbg

RUN dotnet tool install --global dotnet-ef
ENV PATH="$PATH:/root/.dotnet/tools"

# Copy project files and restore NuGet packages
WORKDIR /opt/app-root/src
COPY ../api/ ./api/
COPY ../db/db.csproj ./db/
COPY ../jc-interface-client/jc-interface-client.csproj ./jc-interface-client/
RUN dotnet restore ./api/Unified.Api/Unified.Api.csproj
