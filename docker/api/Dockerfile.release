# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0.301 AS build
WORKDIR /src

# Copy project files
COPY api/Unified.Api/Unified.Api.csproj ./api/Unified.Api/
COPY api/Unified.Audit/Unified.Audit.csproj ./api/Unified.Audit/
COPY api/Unified.Authorization/Unified.Authorization.csproj ./api/Unified.Authorization/
COPY api/Unified.Common/Unified.Common.csproj ./api/Unified.Common/
COPY api/Unified.Core/Unified.Core.csproj ./api/Unified.Core/
COPY api/Unified.Infrastructure/Unified.Infrastructure.csproj ./api/Unified.Infrastructure/
COPY api/Unified.Stats/Unified.Stats.csproj ./api/Unified.Stats/
COPY api/Unified.UserManagement/Unified.UserManagement.csproj ./api/Unified.UserManagement/
COPY api/Unified.Training/Unified.Training.csproj ./api/Unified.Training/
COPY api/Unified.Calendar/Unified.Calendar.csproj ./api/Unified.Calendar/
COPY api/Unified.Hangfire/Unified.Hangfire.csproj ./api/Unified.Hangfire/
COPY api/Unified.JCInterface/Unified.JCInterface.csproj ./api/Unified.JCInterface/
COPY api/Unified.Reporting/Unified.Reporting.csproj ./api/Unified.Reporting/
COPY api/Unified.Leave/Unified.Leave.csproj ./api/Unified.Leave/
COPY api/Unified.Scheduling/Unified.Scheduling.csproj ./api/Unified.Scheduling/
COPY db/db.csproj ./db/
COPY jc-interface-client/jc-interface-client.csproj ./jc-interface-client/

# Restore dependencies
RUN dotnet restore ./api/Unified.Api/Unified.Api.csproj
# Copy source code
COPY api ./api
COPY db ./db
COPY jc-interface-client ./jc-interface-client

# Build and publish
WORKDIR /src/api/Unified.Api
RUN dotnet publish Unified.Api.csproj -c Release -o /app/publish --no-restore

# Runtime stage. Keep this image version aligned with the Microsoft.Playwright package.
FROM mcr.microsoft.com/playwright/dotnet:v1.62.0-noble AS runtime
RUN curl -sSL https://dot.net/v1/dotnet-install.sh | bash /dev/stdin \
    --version 10.0.13 \
    --runtime aspnet \
    --install-dir /usr/share/dotnet
ENV HOME=/tmp
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
WORKDIR /app

# Copy published app
COPY --from=build /app/publish .

# OpenShift can run containers with an arbitrary non-root UID. Make the application
# and preinstalled Playwright browsers readable and executable by the root group.
RUN chgrp -R 0 /app /ms-playwright && chmod -R g=u /app /ms-playwright

# Set environment variables
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production

# Expose port
EXPOSE 8080

# Run as non-root user
USER 1001

# Start the application
ENTRYPOINT ["dotnet", "Unified.Api.dll"]
