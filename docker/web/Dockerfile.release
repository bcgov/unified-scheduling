# Define ARG at the top level
ARG NODE_VERSION=22
# Deprecated / ignored: the web bundle is now built with a fixed placeholder base
# (/__WEB_BASE_HREF__/) that is replaced at container start from the runtime
# WEB_BASE_HREF env var (see vue-on-nginx/s2i/bin/fix-base-url). Kept so existing
# `--build-arg WEB_BASE_HREF=...` invocations in CI continue to work.
ARG WEB_BASE_HREF=/
ARG NGINX_RUNTIME_SRC=./nginx-runtime
ARG VUE_ON_NGINX_SRC=./vue-on-nginx
ARG WEB_SRC=./web
ARG NPM_INSTALL_ARGS=""

###################################################################################
# 1. Build web-runtime
###################################################################################
# Use the offical nginx (based on debian)
FROM nginx:stable AS runtime
ARG NGINX_RUNTIME_SRC
ARG VUE_ON_NGINX_SRC

ENV STI_SCRIPTS_PATH=/usr/libexec/s2i

# Required for HTTP Basic feature
RUN apt-get update -y && \
    apt-get install -y openssl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Copy our OpenShift s2i scripts over to default location
COPY ${VUE_ON_NGINX_SRC}/s2i/bin/ /usr/libexec/s2i/

# Expose this variable to OpenShift
LABEL io.openshift.s2i.scripts-url=image:///usr/libexec/s2i

# Copy config from source to container
COPY ${NGINX_RUNTIME_SRC}/nginx.conf.template /tmp/

# Copy run script
COPY ${NGINX_RUNTIME_SRC}/s2i/bin/run /usr/libexec/s2i/run

# =================================================================================
# Fix up permissions
# ref: https://torstenwalter.de/openshift/nginx/2017/08/04/nginx-on-openshift.html
# - S2I scripts must be executable
# - Make sure nginx can read and write it's working directories.
# - The container dynamically configures nginx on startup
# - The application artifacts live in /tmp
# ---------------------------------------------------------------------------------
RUN chmod -R g+rwx $STI_SCRIPTS_PATH
RUN chmod g+rw /var/cache/nginx \ 
    /var/run \
    /var/log/nginx \
    /etc/nginx/nginx.conf \
    /tmp

# =================================================================================

# Work-around for issues with S2I builds on Windows
WORKDIR /tmp

# Nginx runs on port 8080 by default
EXPOSE 8080

# Switch to usermode
USER 104

###################################################################################
# 2. Build web-artifacts
###################################################################################
FROM registry.access.redhat.com/ubi9/nodejs-${NODE_VERSION} AS artifacts
ARG NODE_VERSION
ARG WEB_SRC
ARG NPM_INSTALL_ARGS

USER root
WORKDIR /opt/app-root/src

# Copy package.json and package-lock.json
COPY ${WEB_SRC}/package*.json .

# Install packages
RUN npm ci ${NPM_INSTALL_ARGS} --ignore-scripts

# Copy the rest of the code
COPY ${WEB_SRC} .

# Build with a fixed placeholder base path. The real base path differs per
# tenant/environment (it depends on the public reverse-proxy prefix), so it is
# substituted at container start by fix-base-url from the WEB_BASE_HREF env var.
ENV WEB_BASE_HREF=/__WEB_BASE_HREF__/
RUN npm run build

###################################################################################
# 3. Build web image
###################################################################################
FROM runtime
ARG VUE_ON_NGINX_SRC

# Copy the build artifacts (built with the /__WEB_BASE_HREF__/ placeholder base)
# from the 'artifacts' image into an immutable template directory. At startup
# fix-base-url regenerates the runtime-writable /tmp/app/dist from this template,
# substituting the runtime WEB_BASE_HREF.
COPY --from=artifacts /opt/app-root/src/dist/. /opt/app/dist-template/

# # Ensure S2I script copied over is runnable.
COPY ${VUE_ON_NGINX_SRC}/s2i/bin/fix-base-url /usr/libexec/s2i/fix-base-url

# Fix permissions.
# - Template is read-only for everyone (works for UID 104 and OpenShift random UID / gid 0).
# - /tmp/app must be writable by UID 104 and gid 0 so /tmp/app/dist can be recreated at start.
USER root
RUN chmod 775 /usr/libexec/s2i/fix-base-url && \
    chmod -R a+rX,go-w /opt/app/dist-template && \
    mkdir -p /tmp/app && \
    chown 104:0 /tmp/app && \
    chmod 775 /tmp/app

# From nginx-runtime.
USER 104

# Since the runtime image is itself an s2i image we need to
# short circuit the s2i lifecycle.
# The runtime image "loses" its s2i runtime voodoo when it 
# is used in a dockerSrategy, which is why the explicit `CMD` is necessary
CMD ["/usr/libexec/s2i/fix-base-url"]
