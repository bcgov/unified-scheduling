{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
    }
  },
  "DatabaseConnectionString": "Host=db;Port=5432;Database=unifieddb;Username=uniuser;Password=unipassword;Enlist=true;MinPoolSize=10;",
  "FeatureFlags": {
    "UserManagement": {
      "Enabled": true,
      "UserBadgeNumber": {
        "Enabled": true
      }
    },
    "Calendar": {
      "Enabled": true,
      "CalendarMatrixTest": true
    },
    "Scheduling": {
      "Enabled": true
    },
    "Stats": {
      "Enabled": true
    },
    "Training": {
      "Enabled": true
    }
  },
  "SeedData": {
    "DataSets": [
      "PlatformSystemUserDataSet",
      "UserManagementPermissionsDataSet",
      "DefaultRolesDataSet",
      "StatsPermissionsDataSet",
      "SheriffRegionLocationDataSet",
      "TrainingPermissionsDataSet"
    ]
  },
  "UserManagement": {
    "UploadPhotoSizeLimitKb": 400
  },
  "Application": {
    "Name": "Unified Scheduling",
    "SupportEmail": "support@example.com"
  },
  "JCInterface": {
    "NonJcInterfaceLocationRegions": {
      "Office of the Chief Sheriff": "Vancouver",
      "Office of Professional Standards": "Vancouver",
      "Sheriff Provincial Operation Centre": "Vancouver",
      "South Okanagan Escort Centre": "Interior",
      "ITAU": "Interior",
      "Central Float Pool": "Fraser"
    }
  },
  "HttpLogging": {
    "Enabled": true,
    "LogBodies": false
  },
  "Hangfire": {
