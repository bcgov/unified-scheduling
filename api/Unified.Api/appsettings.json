{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
    }
  },
  "DatabaseConnectionString": "Host=[DB_HOST];Port=[DB_PORT];Username=[DB_USERNAME];Password=[DB_PASSWORD];Database=[DB_NAME];",
  "FeatureFlags": {
    "UserManagement": {
      "Enabled": true,
      "UserBadgeNumber": {
        "Enabled": true
      }
    },
    "Calendar": {
      "Enabled": false,
      "CalendarMatrixTest": false
    },
    "Scheduling": {
      "Enabled": false
    },
    "Stats": {
      "Enabled": true
    },
    "Training": {
      "Enabled": false
    }
  },
  "CookieName": {
    "UnifiedAuth": "UnifiedAuth"
  },
  "Cors": {
    "AllowedOrigins": "[CORS_ALLOWED_ORIGINS]"
  },
  "SeedData": {
    "DataSets": []
  },
  "CalendarDateTime": {
    "DefaultTimeZoneId": "America/Vancouver"
  },
  "UserManagement": {
    "UploadPhotoSizeLimitKb": "[UPLOAD_PHOTO_SIZE_LIMIT_KB]"
  },
  "Application": {
    "Name": "Unified Scheduling",
    "SupportEmail": "support@example.com"
  },
  "JCInterface": {
    "NonJcInterfaceLocationRegions": {
      "Office of the Chief Sheriff": "Vancouver",
      "Office of Professional Standards": "Vancouver",
      "Sheriff Provincial Operation Centre": "Vancouver",
      "South Okanagan Escort Centre": "Interior",
      "ITAU": "Interior",
      "Central Float Pool": "Fraser"
    }
  },
  "AllowedHosts": "*",
  "HttpLogging": {
    "Enabled": false,
    "LogBodies": false
  },
  "Hangfire": {
    "Enabled": true,
    "ServerEnabled": true,
    "DashboardEnabled": true,
    "PrepareSchemaIfNecessary": false,
    "RetryCount": 3
  }
}
