{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
    }
  },
  "DatabaseConnectionString": "Host=[DB_HOST];Port=[DB_PORT];Username=[DB_USERNAME];Password=[DB_PASSWORD];Database=[DB_NAME];",
  "FeatureFlags": {
    "UserManagement": {
      "Enabled": true,
      "UserBadgeNumber": {
        "Enabled": true
      }
    },
    "Calendar": {
      "Enabled": false,
      "CalendarMatrixTest": false
    },
    "Scheduling": {
      "Enabled": false
    },
    "Stats": {
      "Enabled": true
    },
    "Training": {
      "Enabled": true
    },
    "Reporting": {
      "Enabled": true
    },
    "Leave": {
      "Enabled": true
    }
  },
  "CookieName": {
    "UnifiedAuth": "UnifiedAuth"
  },
  "Cors": {
    "AllowedOrigins": "[CORS_ALLOWED_ORIGINS]"
  },
  "SeedData": {
    "DataSets": []
  },
  "CalendarDateTime": {
    "DefaultTimeZoneId": "America/Vancouver"
  },
  "UserManagement": {
    "UploadPhotoSizeLimitKb": "[UPLOAD_PHOTO_SIZE_LIMIT_KB]"
  },
  "Application": {
    "Name": "Unified Scheduling",
    "SupportEmail": "support@example.com"
  },
  "Training": {
    "ExpiryNotifications": {
      "Enabled": true,
      "CronSchedule": "0 7 * * *"
    }
  },
  "Ches": {
    "Enabled": true,
    "BaseUrl": "https://ches.api.gov.bc.ca/api/v1/",
    "AuthUrl": "",
    "SenderName": "Unified Scheduling",
    "SenderEmail": "",
    "TokenRefreshSkewSeconds": 60,
    "TimeoutSeconds": 30,
    "AllowedAttachmentTypes": [
      {
        "Extension": ".pdf",
        "ContentType": "application/pdf"
      }
    ],
    "MaxAttachmentSizeBytes": 20971520,
    "MaxRecipientsPerMessage": 500
  },
  "JCInterface": {
    "SyncCron": "disabled",
    "NonJcInterfaceLocationRegions": {
      "Office of the Chief Sheriff": "Vancouver",
      "Office of Professional Standards": "Vancouver",
      "Sheriff Provincial Operation Centre": "Vancouver",
      "South Okanagan Escort Centre": "Interior",
      "ITAU": "Interior",
      "Central Float Pool": "Fraser"
    }
  },
  "AllowedHosts": "*",
  "HttpLogging": {
    "Enabled": false,
    "LogBodies": false
  },
  "Hangfire": {
    "Enabled": true,
    "ServerEnabled": true,
    "DashboardEnabled": true,
    "PrepareSchemaIfNecessary": false,
    "RetryCount": 3
  },
  "Branding": {
    "SelectedBrand": "default",
    "brandingOptions":{
      "default": {
        "secondaryLogoUrl": "",
        "secondaryLogoAlt": "",
        "backgroundImageUrl": "",
        "primaryColor": "#013366",
        "backgroundColor": "#FAF9F8",
        "navigationSelectedColor": "#e3a82b",
        "QuickLinks": ["myProfile", "myTeam", "stats", "schedule", "admin", "reporting", "training"],
        "dashboardMessage": "Select your work location, then choose a module below to get started.",
        "header": {
            "title": "Unified Operations Platform",
            "subtitle": "People, scheduling and operations",
            "poweredByText": "",
            "logoUrl": "",
            "logoAlt": "",
            "imageUrl": ""
          }
      },
      "bcss":{
        "secondaryLogoUrl": "/images/branding/bcss/BCSS_Crest-wText_Horizontal_cmyk_pos_white_trimmed.png",
        "secondaryLogoAlt": "B.C. Sheriff Service Crest",
        "backgroundImageUrl": "/images/branding/bcss/BCSS_Crest_cmyk_pos.png",
        "primaryColor": "#234075",
        "backgroundColor": "#FEFEFE",
        "navigationSelectedColor": "#e3a82b",
        "QuickLinks": ["myTeam", "stats", "schedule", "admin"],
        "dashboardMessage": "Select the location you want to work within, then access the modules below to complete tasks for your team or yourself.",
        "header": {
            "title": "Sheriff Operations",
            "subtitle": "BC Sheriff Service",
            "poweredByText": "Powered by Unified Operations Platform (UOps)",
            "logoUrl": "/images/branding/bcss/BCSS_Crest_cmyk_pos.png",
            "logoAlt": "B.C. Sheriff Service Crest and wordmark",
            "imageUrl": "/images/branding/bcss/BCSS_Dashboard_bg.png"
          }
        },
      "quartech": {
        "primaryColor": "#8d394b",
        "backgroundColor": "#FAF9F8",
        "navigationSelectedColor": "#e3a82b",
        "secondaryLogoUrl": "/images/branding/quartech/logo.png",
        "secondaryLogoAlt": "Quartech"
      }
    }
  }
