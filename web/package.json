{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint:check": "oxlint .",
    "lint:eslint:check": "eslint . --cache",
    "lint:check": "run-s lint:oxlint:check lint:eslint:check",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "format": "npm run prettier:fix",
    "clean:api": "node --eval \"import { rmSync } from 'node:fs'; rmSync('./src/api-access/generated', { recursive: true, force: true });\"",
    "gen:api": "orval --config ./orval.config.ts && npm run format",
    "gen:api:clean": "npm run clean:api && npm run gen:api",
    "pre:push": "run-s lint format build test",
    "pre:check": "run-s lint:check prettier:check"
  },
  "dependencies": {
    "@bcgov/design-tokens": "^5.1.0",
    "@date-io/luxon": "^3.2.0",
    "@fullcalendar/core": "^7.1.4",
    "@fullcalendar/vue3": "^7.1.4",
    "@vueuse/core": "^15.0.0",
    "luxon": "^3.7.2",
    "pinia": "^4.1.0",
    "rrule": "^2.8.1",
    "temporal-polyfill": "^1.0.6",
    "vue": "^3.5.44",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.4.0",
    "vuetify": "^4.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@mdi/js": "^7.4.47",
    "@playwright/test": "^1.65.0",
    "@tsconfig/node24": "^24.0.5",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.10.9",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.92.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-vue": "^10.12.0",
    "happy-dom": "^21.0.4",
    "jiti": "^2.7.0",
    "msw": "^2.15.0",
    "npm-run-all2": "^9.0.4",
    "orval": "^8.46.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
