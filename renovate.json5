{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  description: "Repository-specific npm update rules for the Vue 3 and Vite frontend. Inherits shared update policies from the BC Gov preset.",
  extends: ["github>bcgov/renovate-config#2026.8.18"],
  packageRules: [
    {
      description: "Regenerate npm lockfiles consistently",
      matchManagers: ["npm"],
      postUpdateOptions: ["npmInstallTwice"],
    },
    {
      description: "Vue ecosystem",
      matchManagers: ["npm"],
      matchPackageNames: [
        "vue",
        "vue-router",
        "pinia",
        "@vueuse/core",
        "@vue/test-utils",
        "@vue/tsconfig",
      ],
      groupName: "Vue ecosystem",
    },
    {
      description: "Vite tooling",
      matchManagers: ["npm"],
      matchPackageNames: [
        "vite",
        "@vitejs/plugin-vue",
        "vite-plugin-vue-devtools",
      ],
      groupName: "Vite tooling",
    },
    {
      description: "Vuetify",
      matchManagers: ["npm"],
      matchPackageNames: ["vuetify", "vite-plugin-vuetify"],
      groupName: "Vuetify",
    },
    {
      description: "FullCalendar",
      matchManagers: ["npm"],
      matchPackageNames: ["@fullcalendar/core", "@fullcalendar/vue3"],
      groupName: "FullCalendar",
    },
    {
      description: "TypeScript tooling",
      matchManagers: ["npm"],
      matchPackageNames: ["typescript", "@typescript/native", "vue-tsc"],
      groupName: "TypeScript tooling",
    },
    {
      description: "ESLint and Oxlint tooling",
      matchManagers: ["npm"],
      matchPackageNames: [
        "eslint",
        "eslint-config-prettier",
        "eslint-plugin-vue",
        "eslint-plugin-oxlint",
        "eslint-plugin-playwright",
        "@vue/eslint-config-typescript",
        "@vitest/eslint-plugin",
        "oxlint",
        "prettier",
      ],
      groupName: "ESLint and Oxlint tooling",
    },
    {
      description: "Vitest tooling",
      matchManagers: ["npm"],
      matchPackageNames: ["vitest", "happy-dom"],
      groupName: "Vitest tooling",
    },
    {
      description: "Luxon",
      matchManagers: ["npm"],
      matchPackageNames: ["luxon", "@types/luxon", "@date-io/luxon"],
      groupName: "Luxon",
    },
    {
      description: "Node.js types and TypeScript configuration",
      matchManagers: ["npm"],
      matchPackageNames: ["@types/node", "@tsconfig/node24"],
      groupName: "Node.js types and TypeScript configuration",
    },
    {
      description: "Testing dependencies",
      matchManagers: ["npm"],
      matchPackageNames: [
        "@faker-js/faker",
        "@playwright/test",
        "happy-dom",
        "msw",
        "vitest",
      ],
      groupName: "Testing",
    },
    {
      description: "Date and recurrence dependencies",
      matchManagers: ["npm"],
      matchPackageNames: ["rrule", "temporal-polyfill"],
      groupName: "Date and Recurrence",
    },
  ],
}
